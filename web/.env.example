# Copy to web/.env and use absolute host paths.
MIGRATE_V2V_RUNTIME_IMAGE=migrate-v2v-runtime:ubuntu24.04-20261117
HOST_UID=1000
HOST_GID=1000
ARTIFACT_ROOT_HOST=/work/migrate-v2v
VAULT_PASSWORD_FILE_HOST=/path/to/vault-password-file
# Optional: use a fixed appliance at another path.
# Defaults to the image's compressed appliance, unpacked in /tmp at startup.
# LIBGUESTFS_PATH=/work/migrate-v2v/libguestfs-appliance
# Optional: container path to the operator-managed web input directory.
# WEB_INPUT_DIR=/work/migrate-v2v/web-inputs
# Optional for Linux hosts with KVM: enable libguestfs hardware acceleration
# by adding -f web/compose.kvm.yaml to Compose commands. Use the /dev/kvm group ID.
# KVM_GID=...
# Optional: after reviewing and accepting Broadcom's OVF Tool license,
# set to 1 to let standard migration jobs download OVF Tool on demand.
# OVFTOOL_ACCEPT_LICENSE=
# Optional for compose.lan.yaml: this controller's LAN interface IP.
WEB_ADDRESS=127.0.0.1
