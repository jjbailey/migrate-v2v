{
	auto_https disable_redirects
	# IP-literal URLs do not send SNI. Use the configured address as the
	# certificate name for those clients; Caddy still checks the HTTP Host.
	default_sni {$CADDY_DEFAULT_SNI:localhost}
	# Bound request-body, header, response-write, and idle connection timeouts.
	servers {
		timeouts {
			read_body 2m
			read_header 10s
			write 10m
			idle 2m
		}
	}
}

{$CADDY_HOSTS:localhost:8443, 127.0.0.1:8443, [::1]:8443} {
	tls internal
	encode gzip
	reverse_proxy {$CADDY_UPSTREAM:127.0.0.1:8080}
}
