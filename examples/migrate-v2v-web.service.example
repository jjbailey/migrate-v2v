# migrate-v2v-web.service
#
# Runs the controller web app (web/app.py serve) on 127.0.0.1:8080, the
# upstream that caddy.service.example proxies to. Install it next to the
# Caddy unit:
#
#   sudo cp examples/migrate-v2v-web.service.example /etc/systemd/system/migrate-v2v-web.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now migrate-v2v-web
#
# Adjust before installing:
#   User/Group           an account that can read the vault password file
#                        and write ARTIFACT_ROOT (the web state, catalogs and
#                        migration artifacts live there)
#   WorkingDirectory     the repository checkout
#   PATH                 put the Python environment with Ansible first
#                        (e.g. the operator's ~/.dib7/bin)
#   VAULT_PASSWORD_FILE  absolute path; systemd does not expand ~
#
# Create a web account once, as the same user and with the same environment:
#   python3 web/app.py user add operator
#
# On stop, the app sends SIGTERM to a running job's process group and SIGKILL
# after 10s, then marks the job interrupted. KillMode=mixed lets it do that
# before systemd kills whatever is left at TimeoutStopSec.

[Unit]
Description=migrate-v2v controller web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=operator
Group=operator
WorkingDirectory=/path/to/repo
Environment="PATH=/home/operator/.dib7/bin:/usr/local/bin:/usr/bin:/bin"
Environment="ARTIFACT_ROOT=/work/migrate-v2v"
Environment="WEB_STATE_DIR=/work/migrate-v2v/web-state"
Environment="VAULT_PASSWORD_FILE=/home/operator/.dib-vault-pass"
Environment="PYTHONUNBUFFERED=1"
# /usr/bin/env resolves python3 through the PATH above; systemd itself
# would not.
ExecStart=/usr/bin/env python3 web/app.py serve --host 127.0.0.1 --port 8080
KillMode=mixed
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
UMask=0022

[Install]
WantedBy=multi-user.target
