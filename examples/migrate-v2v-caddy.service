[Unit]
Description=Caddy for migrate-v2v controller
After=network-online.target migrate-v2v-web.service
Wants=network-online.target
Requires=migrate-v2v-web.service

[Service]
Type=simple
User=operator
Group=100
WorkingDirectory=/home/operator/migrate-v2v
Environment="HOME=/home/operator"
Environment="CADDY_HOSTS=localhost:8443, 127.0.0.1:8443, [::1]:8443, 192.168.1.119:8443"
Environment="CADDY_DEFAULT_SNI=192.168.1.119"
ExecStart="/usr/bin/caddy" run --config "/home/operator/migrate-v2v/web/Caddyfile"
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
UMask=0022

[Install]
WantedBy=multi-user.target
