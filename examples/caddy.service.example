# caddy.service
#
# For using Caddy with a config file.
#
# Make sure the ExecStart and ExecReload commands are correct
# for your installation.
#
# See https://caddyserver.com/docs/install for instructions.
#
# WARNING: This service does not use the --resume flag, so if you
# use the API to make changes, they will be overwritten by the
# Caddyfile next time the service is restarted. If you intend to
# use Caddy's API to configure it, add the --resume flag to the
# `caddy run` command or use the caddy-api.service file instead.
#
# This unit starts only Caddy. The web app it proxies to
# (CADDY_UPSTREAM, default 127.0.0.1:8080) runs separately; see
# migrate-v2v-web.service.example.
#
# Set PROJECT_HOME to the repository checkout. The User/Group must be able
# to read ${PROJECT_HOME}/web/Caddyfile; Caddy keeps its certificates and
# local CA under that user's home (~/.local/share/caddy).
#
# web/Caddyfile serves only localhost, 127.0.0.1 and [::1] on :8443 unless
# CADDY_HOSTS is set. To serve LAN clients, list every address they will use,
# e.g. Environment="CADDY_HOSTS=localhost:8443, 127.0.0.1:8443, 192.0.2.10:8443"
# and set CADDY_DEFAULT_SNI to the IP clients use in their URL. IP-literal
# URLs omit SNI, so Caddy uses this name and checks that the HTTP Host matches.
#
# Write ${PROJECT_HOME} with braces: systemd expands a bare $VAR only when it
# is a whole word, so $PROJECT_HOME/web/Caddyfile fails to start.
#
# The upstream unit's LimitNPROC=512 is left out on purpose: it counts every
# process of the User, so it breaks the unit (203/EXEC, "Resource
# temporarily unavailable") when User is a login account rather than caddy.

[Unit]
Description=Caddy
Documentation=https://caddyserver.com/docs/
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=notify
User=operator
Group=operator
Environment="PROJECT_HOME=/work/migrate-v2v"
ExecStart=/usr/bin/caddy run --environ --config ${PROJECT_HOME}/web/Caddyfile
ExecReload=/usr/bin/caddy reload --config ${PROJECT_HOME}/web/Caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
